@page "/"

<PageTitle>Zunepedia - Creator</PageTitle>

<section class="zune-shell">
    <div class="zune-card zune-controls" aria-label="Zune selection">
        <fieldset aria-label="Device">
            <div class="device-options">
                @foreach (var device in Catalog.Devices)
                {
                    <button type="button"
                            class="device-option @(device.Type == SelectedType ? "selected" : null)"
                            aria-pressed="@(device.Type == SelectedType)"
                            @onclick="() => SelectDevice(device.Type)">
                        <span class="device-thumb" aria-hidden="true">
                            <ZunePreview Type="@device.Type" Color="@device.DefaultColor" Scale="3" />
                        </span>
                        <span>@device.Name (@device.CodeName)</span>
                    </button>
                }
            </div>
        </fieldset>

        <fieldset aria-label="Colour">
            <div class="style-options">
                @foreach (var style in AvailableStyles)
                {
                    <button type="button"
                            class="style-option @(style.Name == SelectedStyleName ? "selected" : null)"
                            aria-pressed="@(style.Name == SelectedStyleName)"
                            @onclick="() => SelectStyle(style.Name)">
                        <span class="style-swatch" style="background-color: @style.Color" aria-hidden="true"></span>
                        <span>@style.Name</span>
                    </button>
                }
                <div class="custom-style-option @(IsCustomSelected ? "selected" : null)">
                    <button type="button"
                            class="custom-style-select"
                            aria-pressed="@IsCustomSelected"
                            @onclick="SelectCustomStyle">
                        <span class="style-swatch" style="background-color: @CustomColor" aria-hidden="true"></span>
                        <span>Custom</span>
                    </button>
                    @if (IsCustomSelected)
                    {
                        <input type="color"
                               class="custom-color-picker"
                               value="@CustomColor"
                               aria-label="Custom colour for @SelectedDevice.Name"
                               title="Choose a custom colour for @SelectedDevice.Name"
                               @oninput="PreviewCustomColor"
                               @onchange="CommitCustomColor" />
                    }
                </div>
            </div>
        </fieldset>
    </div>

    <div class="zune-card zune-display">
        <div class="zune-stage">
            <ZunePreview Type="@SelectedType" Color="@SelectedColor" Scale="@ExportScale" />
        </div>
        <div class="zune-save-options">
            @if (PngDataUri is not null)
            {
                <a class="btn btn-primary zune-save position-relative" download="@PngFileName" href="@PngDataUri">
                    <span>Save @SelectedStyleName @SelectedDevice.Name (@SelectedDevice.CodeName)</span>
                    <span class="zune-save-badge position-absolute top-100 start-50 translate-middle badge bg-dark rounded-pill">PNG</span>
                </a>
            }
            else
            {
                <span class="btn btn-primary zune-save position-relative disabled"
                      aria-disabled="true"
                      aria-live="polite">
                    <span>@(IsPngRendering
                        ? $"Save {SelectedStyleName} {SelectedDevice.Name} ({SelectedDevice.CodeName})"
                        : "PNG unavailable")</span>
                    <span class="zune-save-badge position-absolute top-100 start-50 translate-middle badge bg-dark rounded-pill">PNG</span>
                </span>
            }
            <a class="btn btn-primary zune-save position-relative" download="@SvgFileName" href="@SvgDataUri">
                <span>Save @SelectedStyleName @SelectedDevice.Name (@SelectedDevice.CodeName)</span>
                <span class="zune-save-badge position-absolute top-100 start-50 translate-middle badge bg-dark rounded-pill">SVG</span>
            </a>
        </div>
        @if (PngError is not null)
        {
            <div class="zune-export-error" role="alert">@PngError</div>
        }
    </div>
</section>
